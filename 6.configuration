<sc-if value="{{isLast}}" hint-placeholder-val="{{false}}"><button onClick="{{activate}}" disabled="{{activateDisabled}}" class="btn-primary" style="height: 44px; padding: 0 18px; border-radius: 12px; border: 0; background: #B01E42; color: #FFFFFF; font: inherit; font-size: 14px; font-weight: 700; cursor: pointer">Activate organisation</button></sc-if>
</div>
</div>
</section>
</div>
</sc-if>
</main>
</div>
</div>
</script>
